# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN CONFIGURATION
ADMIN_EMAIL="rafikibc1000@gmail.com"
ADMIN_WHATSAPP="0716483642"
# ADMIN_SECRET_KEY: Master secret key required to authorize and verify user payments in the Admin Dashboard
ADMIN_SECRET_KEY="rafiki-admin-pass"

# SPORTS API KEY: API-Football (api-sports.io / rapidapi.com)
# Free tier key from api-football.com / dashboard.api-football.com
# Enables real-time worldwide fixture fetching, match status updates, and auto-grading.
SPORTS_API_KEY="0000"

# API SECRET KEY
API_SECRET_KEY="0000"

# FIREBASE SERVICE ACCOUNT KEY: Optional JSON string or base64-encoded service account key
# Generated from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=
