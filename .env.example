# ==============================================================================
# RAFIKI PREDICT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before running the application locally:
#   cp .env.example .env
#
# IMPORTANT:
# - Variables prefixed with VITE_ are exposed to the client-side browser bundle.
# - Variables without VITE_ are kept exclusively server-side.
# - DO NOT commit your actual .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & PLATFORM CONFIGURATION (Server-side)
# ------------------------------------------------------------------------------
PORT=
NODE_ENV=
APP_URL=

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Server-side only)
# ------------------------------------------------------------------------------
# Required for real-time tactical AI match breakdowns and Betting Buddy assistant
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. LIVE SPORTS DATA PROVIDERS (Server-side only)
# ------------------------------------------------------------------------------
# API-Football / API-Sports / RapidAPI key for real-time fixture synchronization
SPORTS_API_KEY=
API_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. ADMINISTRATOR & ACCESS CONTROL (Server-side only)
# ------------------------------------------------------------------------------
# Master secret required to unlock admin management endpoints, verify payments, and generate keys
ADMIN_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_WHATSAPP=

# ------------------------------------------------------------------------------
# 5. GOOGLE FIREBASE & FIRESTORE (Server-side Admin SDK)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 6. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Browser bundle - Vite VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
